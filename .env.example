# Copie para .env e preencha. Nunca comite o .env.

# ── Obrigatórias ────────────────────────────────────────────────────────────

# Postgres. Em produção use SSL (?sslmode=require).
DATABASE_URL=postgresql://academy:academy@localhost:5432/academy

# Segredo de assinatura das sessões. Gere com: openssl rand -base64 32
# Trocar este valor invalida todas as sessões ativas.
APP_SECRET=

# ── Opcionais ───────────────────────────────────────────────────────────────

# URL pública da aplicação. Usada em links de e-mail e em cookies.
APP_URL=http://localhost:3000

# E-mail que recebe o papel de dono no primeiro login.
# Sem ele, nenhuma conta vira administradora automaticamente.
OWNER_EMAIL=

# Porta do servidor (padrão 3000).
PORT=3000

# Envio de e-mail transacional (recuperação de senha), via Cloudflare Email
# Service. Só o token é obrigatório: sem ele, o link de redefinição vai para o
# console do servidor em vez do e-mail da pessoa — dá para testar o fluxo, não
# para usar de verdade. Veja "Recuperação de senha" no README.
CLOUDFLARE_EMAIL_TOKEN=

# Conta e remetente têm padrão no código (a conta da Começa.ai e
# noreply@comeca.ai). Preencha só para sobrescrever.
# CLOUDFLARE_ACCOUNT_ID=
# EMAIL_REMETENTE=noreply@comeca.ai
